# ---------------------------------------------------------------- Python and tooling
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------- secrets (template: .env.example)
.env
.env.*
!.env.example

# ---------------------------------------------------------------- your configuration (template: config.example.yaml)
# Your profile, salary floor, commute towns, ideal job, scoring weights and companies. Created from the template on
# first run and edited on the Settings page.
config.yaml

# ---------------------------------------------------------------- your data
# Everything in data/ is personal (fact bank, original resume, application profile with your address, the job
# database and workflow checkpoints, harvested lists) EXCEPT the committed templates below.
data/*
!data/README.md
!data/facts.example.yaml
!data/apply_profile.example.yaml
!data/resume_template.docx

# Databases anywhere else (a backup or a path moved in config.yaml)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------- generated documents and backups
# Tailored resumes and cover letters, auto-apply screenshots, config/fact/resume backups.
output/
exports/

# Your resumes and documents, wherever they end up
*.docx
!data/resume_template.docx
*.pdf
~$*

# ---------------------------------------------------------------- scratch files and logs
scratch_*
*.log

# ---------------------------------------------------------------- editors and OS
.vscode/
.idea/
.claude/settings.local.json
Thumbs.db
Desktop.ini
.DS_Store
